{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",  // Usa CommonJS en lugar de ESM
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",  // Carpeta de salida para los archivos compilados
    "rootDir": "./src"   // Carpeta de entrada para TypeScript
  },
  "include": ["src/**/*"]
}